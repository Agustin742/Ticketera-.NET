@model List<WebApplication1.Dtos.TicketDto>

<h1>Tickets</h1>

<table>
    <tr><th>Título</th><th>Estado</th><th>Usuario</th></tr>
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.Titulo</td>
            <td>@t.Estado</td>
            <td>@t.NombreUsuario</td>
        </tr>
    }
</table>
